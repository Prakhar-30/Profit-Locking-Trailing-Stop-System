# Copy these environment variables to Vercel
# Dashboard: Settings > Environment Variables
# Add each variable separately, select "All" environments

# Sepolia RPC Endpoint
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Reactive Network RPC Endpoint
VITE_REACTIVE_RPC=https://lasna-rpc.rnk.dev/

# Sepolia Chain ID
VITE_SEPOLIA_CHAIN_ID=11155111

# Reactive Chain ID
VITE_REACTIVE_CHAIN_ID=5318007

# Uniswap V2 Router on Sepolia
VITE_SEPOLIA_ROUTER=0xC532a74256D3Db42D0Bf7a0400fEFDbad7694008

# Reactive Network Callback Sender
VITE_SEPOLIA_CALLBACK_SENDER=0xc9f36411C9897e7F959D99ffca2a0Ba7ee0D7bDA

# ========================================
# INSTRUCTIONS:
# ========================================
# 1. Go to vercel.com and import your GitHub repo
# 2. Set "Root Directory" to: frontend
# 3. Framework will auto-detect as Vite
# 4. Click "Environment Variables"
# 5. Copy each variable above (name and value)
# 6. Select "All" for environment scope
# 7. Click "Deploy"
# ========================================
